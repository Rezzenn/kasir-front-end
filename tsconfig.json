

{
    "compilerOption": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "skipLibCheck": true,
        "moduleRessolution": "bundler",
        "allowImportingTsExtensions": true,
        "resolveJsonModule": true,
        "isolateModules": true,
        "noEmit": true,
        "jsx": "react-jsx",
        "strict": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noFallthroughCasesInSwicth": true,
    },
    "include": ["src"],
}